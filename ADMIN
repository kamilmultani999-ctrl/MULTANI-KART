<html lang="gu"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>MULTANI KART | Nandasan</title>
<style>
:root{--green:#168344;--deep:#0e6232;--lime:#e9f8d9;--ink:#17221b;--muted:#68766d;--line:#e1e9e2;--bg:#f5f8f4;--orange:#ffb33f}
*{box-sizing:border-box}body{margin:0;font-family:Arial,"Noto Sans Gujarati",sans-serif;color:var(--ink);background:var(--bg)}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;border-radius:10px;padding:10px 14px;background:var(--green);color:#fff;font-weight:700}button.secondary{background:#edf4ed;color:var(--deep);border:1px solid #d5e4d5}button.danger{background:#b42318}button:disabled{opacity:.45;cursor:not-allowed}.top{background:linear-gradient(120deg,#0e6232,#1e9a51);color:white;padding:20px max(16px,calc((100% - 1160px)/2));display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}.brand{display:flex;align-items:center;gap:12px}.logo{width:48px;height:48px;background:#fff;color:var(--green);border-radius:14px;display:grid;place-items:center;font-size:27px;font-weight:900}.brand h1{font-size:24px;margin:0;letter-spacing:1px}.brand p{margin:4px 0 0;font-size:13px;opacity:.9}.wrap{max-width:1160px;margin:auto;padding:18px 16px}.hero{background:var(--lime);border:1px solid #d9edc7;border-radius:18px;padding:22px;display:flex;justify-content:space-between;gap:18px;align-items:center}.hero h2{font-size:clamp(23px,4vw,34px);margin:0 0 8px;color:#174d2c}.hero p{margin:0;color:#41634a}.pill{background:#fff;border:1px solid #dce9d9;padding:8px 12px;border-radius:999px;font-size:13px;white-space:nowrap}.tabs{display:flex;gap:8px;overflow:auto;padding:16px 0}.tabs button{white-space:nowrap;background:#e9f0e9;color:#355540}.tabs button.active{background:var(--deep);color:#fff}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}.toolbar input{flex:1;min-width:180px}.field,input,select,textarea{width:100%;border:1px solid #d5dfd6;border-radius:10px;background:#fff;padding:11px;color:var(--ink)}label{font-size:13px;font-weight:700;display:block;margin:10px 0 6px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.card,.panel{background:white;border:1px solid var(--line);border-radius:15px;padding:15px;box-shadow:0 2px 8px #173b1b08}.product-icon{height:92px;border-radius:12px;background:linear-gradient(140deg,#eef8e8,#fff8e8);display:grid;place-items:center;font-size:45px;margin-bottom:12px}.tag{font-size:11px;color:var(--deep);background:#eaf7e9;padding:5px 8px;border-radius:999px;display:inline-block}.product h3{font-size:16px;margin:9px 0 5px}.small{font-size:12px;color:var(--muted)}.price-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:12px}.price{font-size:18px;font-weight:800}.layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:16px}.section-title{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:12px 0}.section-title h2{font-size:21px;margin:0}.cart-item,.order-item{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}.qty{display:flex;align-items:center;gap:8px}.qty button{padding:4px 9px}.total{display:flex;justify-content:space-between;font-weight:800;font-size:18px;padding:14px 0}.hidden{display:none!important}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:16px}.stat strong{font-size:25px;display:block;margin-top:8px}.stat span{font-size:13px;color:var(--muted)}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;font-size:13px}th,td{text-align:left;padding:11px;border-bottom:1px solid var(--line);vertical-align:top}th{background:#f5f8f4}.status{display:inline-block;border-radius:999px;background:#fff1cc;padding:5px 8px;font-size:12px}.notice{background:#fff7e6;border:1px solid #f4d79c;color:#6e4b0b;padding:12px;border-radius:12px;font-size:13px;line-height:1.5}.success{background:#e8f8e9;border-color:#bce5c0;color:#175c29}.foot{text-align:center;color:var(--muted);padding:26px 12px;font-size:12px}.empty{padding:28px;text-align:center;color:var(--muted)}.formgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.row-actions{display:flex;gap:8px;flex-wrap:wrap}.badge{background:#e8f3e8;color:#1d6638;border-radius:8px;padding:4px 7px;font-size:12px}
.login-overlay{position:fixed;inset:0;background:#07160dcc;display:grid;place-items:center;padding:16px;z-index:1000}.login-card{width:min(100%,420px);background:#fff;border-radius:18px;padding:22px;box-shadow:0 18px 70px #0004}.login-card h2{margin:0 0 8px}.login-card .row-actions{margin-top:16px}.login-error{color:#b42318;font-size:13px;min-height:18px;margin-top:8px}
@media(max-width:900px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}.layout{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.card{padding:10px}.product-icon{height:75px}.hero{align-items:flex-start;flex-direction:column}.brand h1{font-size:21px}.wrap{padding:13px 10px}.formgrid{grid-template-columns:1fr}.top{padding:15px}.stats{gap:8px}.stat{padding:11px}.stat strong{font-size:21px}th,td{padding:8px}}
</style></head>
<body>
<header class="top"><div class="brand"><div class="logo">M</div><div><h1>MULTANI KART</h1><p>તમારા ગામની દરેક દુકાન, હવે તમારા મોબાઇલમાં!</p></div></div><div>📍 <b>Nandasan</b> &nbsp; • &nbsp; 🛵 20–30 મિનિટનું લક્ષ્ય</div></header>
<main class="wrap">
<section class="hero"><div><h2>રોજિંદી ખરીદી હવે સરળ! 🛒</h2><p>કરિયાણું, દૂધ, શાકભાજી અને નાસ્તો — સ્થાનિક દુકાનોમાંથી ઓર્ડર કરો.</p></div><span class="pill">💵 Cash on Delivery &nbsp; • &nbsp; 📱 Online (gateway જોડવાનું બાકી)</span></section>
<nav class="tabs" aria-label="Panels">
<button class="active" data-panel="customer">🛍️ Customer</button><button data-panel="shop">🏪 Shopkeeper</button><button data-panel="delivery">🛵 Delivery</button><button data-panel="admin">⚙️ Admin</button>
</nav>
<section id="customer" class="view">
<div class="toolbar"><input id="search" placeholder="પ્રોડક્ટ, કેટેગરી કે દુકાન શોધો…"><button class="secondary" id="reload">↻ Refresh</button></div>
<div class="layout"><div><div class="section-title"><h2>કરિયાણું અને હોટેલનું ખાવાનું</h2><span class="small" id="productCount"></span></div><div id="products" class="grid"></div></div>
<aside class="panel"><div class="section-title"><h2>તમારો કાર્ટ</h2><span class="badge" id="cartCount">0 વસ્તુ</span></div><div id="cart"></div><div class="total"><span>કુલ</span><span id="cartTotal">₹0</span></div>
<div id="checkoutForm"><label>તમારું નામ</label><input id="customerName" placeholder="ગ્રાહકનું નામ"><label>મોબાઇલ નંબર</label><input id="customerPhone" inputmode="tel" placeholder="10 અંકનો નંબર"><label>ઘરનું સરનામું, Nandasan</label><textarea id="customerAddress" rows="2" placeholder="શેરી / વિસ્તાર / ઓળખ"></textarea><label>પેમેન્ટ</label><select id="payment"><option value="COD">Cash on Delivery</option><option value="ONLINE">Online Payment (gateway જોડવાનું બાકી)</option></select><button style="width:100%;margin-top:12px" id="placeOrder">ઓર્ડર કરો</button></div><p class="small">ટેસ્ટ માટે જ ડેટા દાખલ કરો. આ ડેમો જાહેર ગ્રાહકો માટે હજુ તૈયાર નથી.</p></aside></div>
</section>
<section id="shop" class="view hidden"><div class="section-title"><h2>Shopkeeper Panel</h2><span class="small">ડેમો: દુકાન અને સ્ટોક મેનેજમેન્ટ</span></div>
<div class="panel"><h3>નવી વસ્તુ ઉમેરો</h3><div class="formgrid"><div><label>વસ્તુનું નામ</label><input id="pName" placeholder="ઉદાહરણ: દૂધ 500ml"></div><div><label>કેટેગરી</label><select id="pCategory"><option>Grocery</option><option>Dairy</option><option>Vegetables</option><option>Fruits</option><option>Snacks</option><option>Beverages</option><option>Home Care</option></select></div><div><label>ભાવ (₹)</label><input id="pPrice" type="number" min="0" placeholder="30"></div><div><label>સ્ટોક</label><input id="pStock" type="number" min="0" placeholder="20"></div><div style="grid-column:1/-1"><label>દુકાનનું નામ</label><input id="pShop" placeholder="તમારી દુકાનનું નામ"></div></div><button id="addProduct" style="margin-top:12px">+ વસ્તુ ઉમેરો</button></div>
<div class="panel" style="margin-top:14px"><h3>વસ્તુઓ અને સ્ટોક</h3><div id="shopProducts" class="table-wrap"></div></div>
</section>
<section id="delivery" class="view hidden"><div class="section-title"><h2>Delivery Panel</h2><span class="small">ઓર્ડર સ્ટેટસ અપડેટ કરો</span></div><div class="notice">ડિલિવરી સમય 20–30 મિનિટનું લક્ષ્ય છે; વાસ્તવિક સમય દુકાન, અંતર અને ઓર્ડર પર આધારિત રહેશે.</div><div id="deliveryOrders" style="margin-top:14px"></div></section>
<section id="admin" class="view hidden"><div class="section-title"><h2>Admin Dashboard</h2><button class="secondary" id="adminRefresh">Refresh dashboard</button></div><div id="stats" class="stats"></div><div class="panel"><h3>બધા ઓર્ડર</h3><div id="adminOrders" class="table-wrap"></div></div><div class="notice" style="margin-top:14px">Admin Login ચાલુ છે. આ તબક્કે Admin credentials Shopkeeper અને Delivery પેનલ માટે પણ વપરાય છે; અલગ role permissions પછી ઉમેરવાના છે. વાસ્તવિક ઓર્ડર પહેલાં કાયમી PostgreSQL ડેટાબેઝ અને notification integration જરૂરી છે.</div></section>
<div class="panel" style="margin-top:18px"><b>ઓર્ડર સહાય / WhatsApp:</b> <a href="https://wa.me/918488807767" target="_blank" rel="noopener">+91 84888 07767</a><div class="small">ઓર્ડર વેબસાઇટમાં નોંધાયા પછી WhatsApp પર વિગતો મોકલવાની સુવિધા છે. ગ્રાહકે WhatsAppમાં Send દબાવવું જરૂરી છે.</div></div>
<div class="foot">© MULTANI KART • Nandasan • Local grocery delivery starter</div>
</main>
<div id="loginOverlay" class="login-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="loginTitle">
  <form id="loginForm" class="login-card">
    <h2 id="loginTitle">MULTANI KART Admin Login</h2>
    <p class="small">આ પેનલ માટે અધિકૃત Admin Username અને Password જરૂરી છે.</p>
    <label for="adminUsername">Username</label><input id="adminUsername" autocomplete="username" required="">
    <label for="adminPassword">Password</label><input id="adminPassword" type="password" autocomplete="current-password" required="">
    <div id="loginError" class="login-error"></div>
    <div class="row-actions"><button type="submit">Login</button><button type="button" class="secondary" id="cancelLogin">Cancel</button></div>
  </form>
</div>
<script>
const $=id=>document.getElementById(id);
let products=[], orders=[], cart={};
const money=n=>"₹"+Number(n||0).toLocaleString("en-IN",{maximumFractionDigits:2});
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const icons={Dairy:"🥛",Vegetables:"🥦",Grocery:"🌾",Snacks:"🍪",Beverages:"🥤","Home Care":"🧼",Fruits:"🍌", "Hotel Food":"🍛", "Personal Care":"🧴", Household:"🕯️", Sweets:"🍬"};
async function api(url,opts={}){const r=await fetch(url,{credentials:"same-origin",headers:{"Content-Type":"application/json"},...opts});const d=await r.json();if(!r.ok)throw Error(d.error||"કંઈક ખોટું થયું");return d}
function toast(msg){alert(msg)}
async function loadProducts(){products=await api("/api/products?q="+encodeURIComponent($("search").value||""));renderProducts();renderCart();renderShopProducts()}
async function loadOrders(){orders=await api("/api/orders");renderDelivery();renderAdminOrders();renderStats()}
function renderProducts(){$("productCount").textContent=products.length+" વસ્તુઓ";$("products").innerHTML=products.length?products.map(p=>`<article class="card product"><div class="product-icon">${icons[p.category]||"🛍️"}</div><span class="tag">${esc(p.category)}</span><h3>${esc(p.name)}</h3><div class="small">${esc(p.shop)} • સ્ટોક ${p.stock}</div><div class="price-row"><span class="price">${money(p.price)}</span><button ${p.stock<1?"disabled":""} onclick="addToCart(${p.id})">+ ઉમેરો</button></div></article>`).join(""):`<div class="empty">વસ્તુ મળી નથી.</div>`}
function addToCart(id){const p=products.find(x=>x.id===id);if(!p)return;cart[id]=Math.min(p.stock,(cart[id]||0)+1);renderCart()}
function changeQty(id,delta){const p=products.find(x=>x.id===id);if(!p)return;cart[id]=Math.min(p.stock,Math.max(0,(cart[id]||0)+delta));if(!cart[id])delete cart[id];renderCart()}
function renderCart(){const entries=Object.entries(cart).filter(([id,q])=>q>0&&products.some(p=>p.id===Number(id)));$("cartCount").textContent=entries.reduce((s,[,q])=>s+q,0)+" વસ્તુ";$("cart").innerHTML=entries.length?entries.map(([id,q])=>{const p=products.find(x=>x.id===Number(id));return `<div class="cart-item"><div><b>${esc(p.name)}</b><div class="small">${money(p.price)} × ${q}</div></div><div class="qty"><button class="secondary" onclick="changeQty(${id},-1)">−</button><b>${q}</b><button class="secondary" onclick="changeQty(${id},1)">+</button></div></div>`}).join(""):`<div class="empty">તમારો કાર્ટ ખાલી છે 🛒</div>`;$("cartTotal").textContent=money(entries.reduce((s,[id,q])=>s+products.find(p=>p.id===Number(id)).price*q,0));$("placeOrder").disabled=!entries.length}
async function placeOrder(){try{const customer=$("customerName").value.trim(),phone=$("customerPhone").value.trim(),address=$("customerAddress").value.trim();if(!customer||!phone||!address)return toast("નામ, મોબાઇલ અને સરનામું ભરો.");if(!/^[0-9+\-\s]{10,15}$/.test(phone))return toast("યોગ્ય મોબાઇલ નંબર લખો.");const order=await api("/api/orders",{method:"POST",body:JSON.stringify({customer,phone,address,payment:$("payment").value,items:Object.entries(cart).map(([id,qty])=>({id:Number(id),qty}))})});const orderItems=Object.entries(cart).map(([id,qty])=>{const p=products.find(x=>x.id===Number(id));return p?`${p.name} x ${qty} = ₹${p.price*qty}`:""}).filter(Boolean);
const total=order.total;
cart={};toast("ઓર્ડર #"+order.id+" નોંધાયો! હવે WhatsApp પર ઓર્ડર મોકલવા માટે આગળનું બટન દબાવો."); 
const msg=`MULTANI KART - New Order #${order.id}
Name: ${customer}
Phone: ${phone}
Address: ${address}
Payment: ${order.payment==="COD"?"Cash on Delivery":"Online payment requested (not yet paid)"}
Items:
${orderItems.join("\\n")}
Total: ₹${total}
Order time: ${order.created_at}`;
const sendBtn=document.createElement("button");sendBtn.textContent="WhatsApp પર ઓર્ડર મોકલો";sendBtn.style.cssText="width:100%;margin-top:8px;background:#168344";
sendBtn.onclick=()=>window.open("https://wa.me/918488807767?text="+encodeURIComponent(msg),"_blank","noopener");
$("checkoutForm").appendChild(sendBtn);
await loadProducts();await loadOrders()}catch(e){toast(e.message)}}
function renderShopProducts(){$("shopProducts").innerHTML=`<table><thead><tr><th>વસ્તુ</th><th>દુકાન</th><th>ભાવ</th><th>સ્ટોક</th><th>સાચવો</th></tr></thead><tbody>${products.map(p=>`<tr><td>${esc(p.name)}<div class="small">${esc(p.category)}</div></td><td>${esc(p.shop)}</td><td><input style="min-width:75px" id="price-${p.id}" type="number" min="0" value="${p.price}"></td><td><input style="min-width:65px" id="stock-${p.id}" type="number" min="0" value="${p.stock}"></td><td><button onclick="saveProduct(${p.id})">Save</button></td></tr>`).join("")}</tbody></table>`}
async function saveProduct(id){try{await api("/api/products/"+id,{method:"PATCH",body:JSON.stringify({price:Number($("price-"+id).value),stock:Number($("stock-"+id).value)})});toast("વસ્તુ અપડેટ થઈ.");await loadProducts()}catch(e){toast(e.message)}}
async function addProduct(){try{const name=$("pName").value.trim(),shop=$("pShop").value.trim();if(!name||!shop)return toast("વસ્તુનું નામ અને દુકાનનું નામ ભરો.");await api("/api/products",{method:"POST",body:JSON.stringify({name,category:$("pCategory").value,price:Number($("pPrice").value),stock:Number($("pStock").value),shop})});["pName","pPrice","pStock"].forEach(id=>$(id).value="");toast("નવી વસ્તુ ઉમેરાઈ.");await loadProducts()}catch(e){toast(e.message)}}
const statusOptions=["New","Accepted","Packed","Out for Delivery","Delivered","Cancelled"];
function statusSelect(o){return `<select onchange="updateStatus(${o.id},this.value)">${statusOptions.map(s=>`<option ${o.status===s?"selected":""}>${s}</option>`).join("")}</select>`}
function itemSummary(o){return o.items.map(i=>`${esc(i.name)} × ${i.qty}`).join("<br>")}
function renderDelivery(){const list=orders.filter(o=>!["Delivered","Cancelled"].includes(o.status));$("deliveryOrders").innerHTML=list.length?list.map(o=>`<div class="panel" style="margin-bottom:12px"><div class="section-title"><h3>ઓર્ડર #${o.id}</h3><span class="status">${esc(o.status)}</span></div><p><b>${esc(o.customer)}</b> • ${esc(o.phone)}</p><p>${esc(o.address)}</p><p>${itemSummary(o)}</p><div class="price-row"><b>${money(o.total)} • ${o.payment==="COD"?"Cash":"Online (pending)"}</b>${statusSelect(o)}</div></div>`).join(""):`<div class="panel empty">હાલમાં કોઈ પેન્ડિંગ ડિલિવરી નથી.</div>`}
function renderAdminOrders(){$("adminOrders").innerHTML=orders.length?`<table><thead><tr><th>ઓર્ડર</th><th>ગ્રાહક</th><th>વસ્તુઓ</th><th>કુલ</th><th>પેમેન્ટ</th><th>સ્ટેટસ</th><th>સમય</th></tr></thead><tbody>${orders.map(o=>`<tr><td>#${o.id}</td><td>${esc(o.customer)}<div class="small">${esc(o.phone)}<br>${esc(o.address)}</div></td><td>${itemSummary(o)}</td><td>${money(o.total)}</td><td>${o.payment==="COD"?"Cash on Delivery":"Online"}<div class="small">${esc(o.payment_status)}</div></td><td>${statusSelect(o)}</td><td>${esc(o.created_at)}</td></tr>`).join("")}</tbody></table>`:`<div class="empty">હજુ કોઈ ઓર્ડર નથી.</div>`}
async function renderStats(){try{const s=await api("/api/admin/summary");$("stats").innerHTML=[["કુલ ઓર્ડર",s.orders],["અંદાજિત વેચાણ",money(s.revenue)],["પેન્ડિંગ ઓર્ડર",s.pending],["એક્ટિવ વસ્તુઓ",s.products]].map(([label,val])=>`<div class="panel stat"><span>${label}</span><strong>${val}</strong></div>`).join("")}catch(e){$("stats").textContent=e.message}}
async function updateStatus(id,status){try{await api("/api/orders/"+id+"/status",{method:"PATCH",body:JSON.stringify({status})});await loadOrders()}catch(e){toast(e.message)}}
let currentPanel="customer";
function showPanel(name){currentPanel=name;document.querySelectorAll("[data-panel]").forEach(x=>x.classList.toggle("active",x.dataset.panel===name));document.querySelectorAll(".view").forEach(v=>v.classList.toggle("hidden",v.id!==name));}
function openAdminLogin(){$("loginError").textContent="";$("adminPassword").value="";$("loginOverlay").classList.remove("hidden");$("adminUsername").focus()}
async function ensureAdmin(){try{const me=await api("/api/me");if(me.authenticated)return true;}catch(e){}openAdminLogin();return false;}
document.querySelectorAll("[data-panel]").forEach(b=>b.addEventListener("click",async()=>{
 const name=b.dataset.panel;
 if(["admin","shop","delivery"].includes(name)){
   const ok=await ensureAdmin(); if(!ok)return;
   showPanel(name); if(name==="admin"||name==="delivery") await loadOrders(); if(name==="shop") await loadProducts();
 } else showPanel(name);
}));
$("loginForm").addEventListener("submit",async e=>{e.preventDefault();$("loginError").textContent="";try{await api("/api/login",{method:"POST",body:JSON.stringify({username:$("adminUsername").value.trim(),password:$("adminPassword").value})});$("loginOverlay").classList.add("hidden");showPanel(currentPanel==="customer"?"admin":currentPanel);await loadOrders();toast("Admin Login સફળ થયું.");}catch(err){$("loginError").textContent=err.message;}});
$("cancelLogin").onclick=()=>$("loginOverlay").classList.add("hidden");
$("search").addEventListener("input",()=>loadProducts().catch(e=>toast(e.message)));
$("reload").onclick=()=>Promise.all([loadProducts(),loadOrders()]).catch(e=>toast(e.message));
$("placeOrder").onclick=placeOrder;$("addProduct").onclick=addProduct;$("adminRefresh").onclick=()=>loadOrders().catch(e=>toast(e.message));
loadProducts().catch(e=>toast("સર્વર ચાલુ છે કે નહીં તપાસો. "+e.message));
</script></body></html>
